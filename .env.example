# Database
DB_USER=postgres
DB_PASSWORD=postgres

# RabbitMQ
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# JWT — base64-encoded secret (min 32 bytes)
JWT_SECRET=bXktc3VwZXItc2VjcmV0LWtleS1mb3ItZXZlbnQtcGxhdGZvcm0tMjAyNQ==

# Admin second-level security code (required for role changes)
ADMIN_SECURITY_CODE=admin-secure-2025

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
MAIL_FROM=noreply@eventplatform.com
