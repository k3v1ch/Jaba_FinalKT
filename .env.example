# Database — use a STRONG password in production
DB_USER=postgres
DB_PASSWORD=change-me-strong

# RabbitMQ — broker reads RABBITMQ_USER/PASS; services read RABBITMQ_USERNAME/PASSWORD.
# Keep both pairs in sync.
RABBITMQ_USER=eventmq
RABBITMQ_PASS=change-me-strong
RABBITMQ_USERNAME=eventmq
RABBITMQ_PASSWORD=change-me-strong

# JWT — base64-encoded secret (min 32 bytes).
# REQUIRED — generate with: openssl rand -base64 48
JWT_SECRET=

# Admin second-level security code (required for role changes).
# REQUIRED — choose a strong value before first run.
ADMIN_SECURITY_CODE=

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
MAIL_FROM=noreply@eventplatform.com

# Mail transport security:
#   STARTTLS on 587  -> MAIL_SSL_ENABLE=false  MAIL_STARTTLS_ENABLE=true
#   implicit SSL 465 -> MAIL_SSL_ENABLE=true   MAIL_STARTTLS_ENABLE=false
MAIL_SSL_ENABLE=false
MAIL_STARTTLS_ENABLE=true

# Public URL (used in email links), e.g. https://event.example.com
FRONTEND_URL=http://localhost:8000
